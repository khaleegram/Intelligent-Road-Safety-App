{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "seed:accidents": "node scripts/seed-accidents.mjs",
    "typecheck": "tsc --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test --test-concurrency=1 --experimental-test-isolation=none .test-dist/services/offlineQueue.test.js && node --test --test-concurrency=1 --experimental-test-isolation=none .test-dist/services/reportValidation.test.js && node --test --test-concurrency=1 --experimental-test-isolation=none .test-dist/services/i18nParity.test.js",
    "prebuild:native": "npx expo prebuild",
    "run:android": "npx expo run:android",
    "run:ios": "npx expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.12.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@rnmapbox/maps": "^10.3.16",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "firebase": "^12.8.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "firebase-admin": "^13.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
